{
  "name": "outbound-motionn",
  "version": "0.1.0",
  "description": "MCP server that unifies search across outbound data sources (Salesforce, Salesfinity, Fathom, Amplemarket, OpenFunnel) for LLM access.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "outbound-motionn": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
