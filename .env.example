# Copy to .env and fill in the sources you have credentials for.
# A connector with missing variables is skipped, not treated as an error.

# Salesforce (SOSL search across Account/Contact/Opportunity)
SALESFORCE_INSTANCE_URL=https://your-domain.my.salesforce.com
SALESFORCE_ACCESS_TOKEN=
# SALESFORCE_API_VERSION=v60.0

# Salesfinity (dialer call logs)
SALESFINITY_API_KEY=
# SALESFINITY_BASE_URL=https://api.salesfinity.co/v1

# Fathom (call recordings/summaries)
FATHOM_API_KEY=
# FATHOM_BASE_URL=https://api.fathom.ai/external/v1

# Amplemarket (people/company search)
AMPLEMARKET_API_KEY=
# AMPLEMARKET_BASE_URL=https://api.amplemarket.com

# OpenFunnel (agentic account/prospect research)
OPENFUNNEL_API_KEY=
# OPENFUNNEL_BASE_URL=https://api.openfunnel.ai/v1
